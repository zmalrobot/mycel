<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TopoOpt.App.ViewModels"
        xmlns:controls="using:TopoOpt.App.Controls"
        xmlns:rendering="using:TopoOpt.App.Rendering"
        xmlns:vox="using:TopoOpt.Core.Voxelization"
        xmlns:wf="using:TopoOpt.Core.Workflow"
        x:Class="TopoOpt.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource App.Title}"
        Width="1340"
        Height="840"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource Bg0}"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="44,*,26">

    <!-- 1. Top Bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource Bg1}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource Pad12H}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Action Buttons -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}" VerticalAlignment="Center">
          <Button Content="{DynamicResource Toolbar.OpenStl}"
                  Click="OnOpenStlClick"
                  Background="{DynamicResource Accent}"
                  Foreground="{DynamicResource TextPrimary}"
                  FontWeight="SemiBold"
                  Padding="{DynamicResource Pad12_8}"
                  CornerRadius="{DynamicResource CornerRadius}"
                  ToolTip.Tip="{DynamicResource Toolbar.OpenStl.Tooltip}" />

          <Button Content="{DynamicResource Toolbar.OpenProject}"
                  Click="OnOpenProjectClick"
                  Background="{DynamicResource Bg2}"
                  Foreground="{DynamicResource TextPrimary}"
                  Padding="{DynamicResource Pad12_8}"
                  CornerRadius="{DynamicResource CornerRadius}"
                  ToolTip.Tip="{DynamicResource Toolbar.OpenProject.Tooltip}" />

          <Button Content="{DynamicResource Toolbar.SaveProject}"
                  Click="OnSaveProjectClick"
                  Background="{DynamicResource Bg2}"
                  Foreground="{DynamicResource TextPrimary}"
                  Padding="{DynamicResource Pad12_8}"
                  CornerRadius="{DynamicResource CornerRadius}"
                  ToolTip.Tip="{DynamicResource Toolbar.SaveProject.Tooltip}" />

          <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="{DynamicResource Margin4H}" />

          <Button Content="{DynamicResource Toolbar.FitView}"
                  Click="OnFitViewClick"
                  Background="{DynamicResource Bg2}"
                  Foreground="{DynamicResource TextPrimary}"
                  Padding="{DynamicResource Pad12_8}"
                  CornerRadius="{DynamicResource CornerRadius}"
                  ToolTip.Tip="{DynamicResource Toolbar.FitView.Tooltip}" />

          <Button Content="{DynamicResource Toolbar.About}"
                  Command="{Binding OpenAboutDialogCommand}"
                  Background="{DynamicResource Bg2}"
                  Foreground="{DynamicResource TextPrimary}"
                  Padding="{DynamicResource Pad12_8}"
                  CornerRadius="{DynamicResource CornerRadius}"
                  ToolTip.Tip="{DynamicResource Toolbar.About.Tooltip}" />
        </StackPanel>

        <!-- Center Model Header Summary -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource Spacing12}">
          <TextBlock Text="{Binding ModelFileName}"
                     FontWeight="SemiBold"
                     FontSize="12"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" />

          <Border Background="{DynamicResource Bg2}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8_4}">
            <TextBlock Text="{Binding StatusTriangles}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
          </Border>

          <Border Background="{DynamicResource Bg2}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8_4}">
            <TextBlock Text="{Binding StatusBBox}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
          </Border>

          <Border Background="{Binding WatertightBadgeBrush}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8_4}">
            <TextBlock Text="{Binding WatertightText}" FontSize="11" Foreground="{DynamicResource TextPrimary}" FontWeight="Medium" />
          </Border>
        </StackPanel>

        <!-- Right Quick Info -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}" VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentProjectPath}"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center"
                     MaxWidth="200"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. Main Workspace: Left Stepper Panel + 3D Viewport Area -->
    <Grid Grid.Row="1" ColumnDefinitions="360,*">

      <!-- Left Stepper Accordion Column -->
      <Border Grid.Column="0"
              Background="{DynamicResource Bg0}"
              BorderBrush="{DynamicResource Border}"
              BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="{DynamicResource Spacing8}" Margin="{DynamicResource Pad12}">

            <!-- STEP 1: MODEL -->
            <Border Background="{DynamicResource Bg1}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel>
                <!-- Step Header -->
                <Button Command="{Binding SelectStepCommand}" CommandParameter="1"
                        Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="{DynamicResource Pad12_8}"
                        ToolTip.Tip="{DynamicResource Stepper.Model.Tooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
                      <Border Width="22" Height="22" CornerRadius="{DynamicResource CornerRadius}" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Common.Step1Number}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{DynamicResource Stepper.Model.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Stepper.Common.CompletedCheck}" Foreground="{DynamicResource Preserve}" FontWeight="Bold" FontSize="14" IsVisible="{Binding IsStep1Completed}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Step Body -->
                <StackPanel Margin="{DynamicResource PadBody}" Spacing="{DynamicResource Spacing8}" IsVisible="{Binding ActiveStep, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                  <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource Margin4T}">
                    <TextBlock Text="{DynamicResource Stepper.Model.ImportUnit}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding SelectedUnit}" Width="120" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Model.Triangles}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusTriangles}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Model.Vertices}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusVertices}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Model.BoundingBox}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusBBox}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Model.Volume}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusVolume}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- STEP 2: LOADS -->
            <Border Background="{DynamicResource Bg1}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel>
                <!-- Step Header -->
                <Button Command="{Binding SelectStepCommand}" CommandParameter="2"
                        Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="{DynamicResource Pad12_8}"
                        ToolTip.Tip="{DynamicResource Stepper.Loads.Tooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
                      <Border Width="22" Height="22" CornerRadius="{DynamicResource CornerRadius}" Background="{DynamicResource Load}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Common.Step2Number}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{DynamicResource Stepper.Loads.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Stepper.Common.CompletedCheck}" Foreground="{DynamicResource Preserve}" FontWeight="Bold" FontSize="14" IsVisible="{Binding IsStep2Completed}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Step Body -->
                <StackPanel Margin="{DynamicResource PadBody}" Spacing="{DynamicResource Spacing8}" IsVisible="{Binding ActiveStep, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                  <Button Content="{DynamicResource Stepper.Loads.Add}"
                          Command="{Binding AddLoadCommand}"
                          Background="{DynamicResource Load}"
                          Foreground="{DynamicResource TextPrimary}"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="{DynamicResource Pad8_4}"
                          CornerRadius="{DynamicResource CornerRadius}"
                          ToolTip.Tip="{DynamicResource Stepper.Loads.Add.Tooltip}" />

                  <ItemsControl ItemsSource="{Binding Loads}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:LoadItemViewModel">
                        <Border Background="{DynamicResource Bg2}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8}" Margin="{DynamicResource Margin4V}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                          <StackPanel Spacing="{DynamicResource Spacing8}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBox Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource Bg1}" Padding="{DynamicResource Pad4}" />
                              <Button Grid.Column="1" Content="{DynamicResource Stepper.Common.RemoveSymbol}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveLoadCommand}"
                                      CommandParameter="{Binding}"
                                      Background="Transparent" Foreground="{DynamicResource Danger}" Padding="{DynamicResource Pad8_4}" Margin="{DynamicResource Margin4L}"
                                      ToolTip.Tip="{DynamicResource Stepper.Loads.Remove.Tooltip}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{DynamicResource Stepper.Loads.Magnitude}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                              <NumericUpDown Grid.Column="1" Value="{Binding MagnitudeNewtons}" Minimum="1" Maximum="1000000" Increment="50" Width="110" Height="26"
                                             ToolTip.Tip="{DynamicResource Stepper.Loads.Magnitude.Tooltip}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{DynamicResource Stepper.Loads.Direction}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                              <ComboBox Grid.Column="1"
                                        ItemsSource="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AvailableLoadDirections}"
                                        SelectedItem="{Binding DirectionMode}"
                                        Width="150" />
                            </Grid>

                            <!-- Custom Vector Controls -->
                            <StackPanel Spacing="{DynamicResource Spacing4}" IsVisible="{Binding DirectionMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static wf:LoadDirectionMode.CustomVector}}">
                              <Grid ColumnDefinitions="*,*,*">
                                <NumericUpDown Grid.Column="0" Value="{Binding CustomX}" Increment="0.1" Margin="{DynamicResource Pad4}"
                                               ToolTip.Tip="{DynamicResource Stepper.Loads.CustomX.Tooltip}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding CustomY}" Increment="0.1" Margin="{DynamicResource Pad4}"
                                               ToolTip.Tip="{DynamicResource Stepper.Loads.CustomY.Tooltip}" />
                                <NumericUpDown Grid.Column="2" Value="{Binding CustomZ}" Increment="0.1" Margin="{DynamicResource Pad4}"
                                               ToolTip.Tip="{DynamicResource Stepper.Loads.CustomZ.Tooltip}" />
                              </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding TriangleCount, StringFormat='{}{0} triangles'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                              <ToggleButton Grid.Column="1" Content="{DynamicResource Stepper.Common.PickOnMesh}"
                                            IsChecked="{Binding IsPicking}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePickLoadCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource Bg1}" Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                                            ToolTip.Tip="{DynamicResource Stepper.Common.PickOnMesh.Tooltip}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- STEP 3: SUPPORTS -->
            <Border Background="{DynamicResource Bg1}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel>
                <!-- Step Header -->
                <Button Command="{Binding SelectStepCommand}" CommandParameter="3"
                        Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="{DynamicResource Pad12_8}"
                        ToolTip.Tip="{DynamicResource Stepper.Supports.Tooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
                      <Border Width="22" Height="22" CornerRadius="{DynamicResource CornerRadius}" Background="{DynamicResource Support}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Common.Step3Number}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{DynamicResource Stepper.Supports.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Stepper.Common.CompletedCheck}" Foreground="{DynamicResource Preserve}" FontWeight="Bold" FontSize="14" IsVisible="{Binding IsStep3Completed}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Step Body -->
                <StackPanel Margin="{DynamicResource PadBody}" Spacing="{DynamicResource Spacing8}" IsVisible="{Binding ActiveStep, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}">
                  <Button Content="{DynamicResource Stepper.Supports.Add}"
                          Command="{Binding AddSupportCommand}"
                          Background="{DynamicResource Support}"
                          Foreground="{DynamicResource TextPrimary}"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="{DynamicResource Pad8_4}"
                          CornerRadius="{DynamicResource CornerRadius}"
                          ToolTip.Tip="{DynamicResource Stepper.Supports.Add.Tooltip}" />

                  <ItemsControl ItemsSource="{Binding Supports}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:SupportItemViewModel">
                        <Border Background="{DynamicResource Bg2}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8}" Margin="{DynamicResource Margin4V}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                          <StackPanel Spacing="{DynamicResource Spacing8}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBox Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource Bg1}" Padding="{DynamicResource Pad4}" />
                              <Button Grid.Column="1" Content="{DynamicResource Stepper.Common.RemoveSymbol}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveSupportCommand}"
                                      CommandParameter="{Binding}"
                                      Background="Transparent" Foreground="{DynamicResource Danger}" Padding="{DynamicResource Pad8_4}" Margin="{DynamicResource Margin4L}"
                                      ToolTip.Tip="{DynamicResource Stepper.Supports.Remove.Tooltip}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing12}">
                              <CheckBox Content="{DynamicResource Stepper.Supports.FixX}" IsChecked="{Binding FixX}" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                              <CheckBox Content="{DynamicResource Stepper.Supports.FixY}" IsChecked="{Binding FixY}" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                              <CheckBox Content="{DynamicResource Stepper.Supports.FixZ}" IsChecked="{Binding FixZ}" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding TriangleCount, StringFormat='{}{0} triangles'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                              <ToggleButton Grid.Column="1" Content="{DynamicResource Stepper.Common.PickOnMesh}"
                                            IsChecked="{Binding IsPicking}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePickSupportCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource Bg1}" Foreground="{DynamicResource TextPrimary}" FontSize="11" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                                            ToolTip.Tip="{DynamicResource Stepper.Common.PickOnMesh.Tooltip}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- STEP 4: MATERIAL -->
            <Border Background="{DynamicResource Bg1}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel>
                <!-- Step Header -->
                <Button Command="{Binding SelectStepCommand}" CommandParameter="4"
                        Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="{DynamicResource Pad12_8}"
                        ToolTip.Tip="{DynamicResource Stepper.Material.Tooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
                      <Border Width="22" Height="22" CornerRadius="{DynamicResource CornerRadius}" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Common.Step4Number}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{DynamicResource Stepper.Material.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Stepper.Common.CompletedCheck}" Foreground="{DynamicResource Preserve}" FontWeight="Bold" FontSize="14" IsVisible="{Binding IsStep4Completed}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Step Body -->
                <StackPanel Margin="{DynamicResource PadBody}" Spacing="{DynamicResource Spacing8}" IsVisible="{Binding ActiveStep, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Material.Preset}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMaterialPresets}" SelectedItem="{Binding SelectedMaterialPreset}" Width="140" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Material.YoungModulus}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding MaterialE}" Minimum="100" Maximum="50000" Increment="100" Width="110" Height="26"
                                   ToolTip.Tip="{DynamicResource Stepper.Material.YoungModulus.Tooltip}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Material.PoissonRatio}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding MaterialNu}" Minimum="0.05" Maximum="0.49" Increment="0.01" FormatString="F2" Width="110" Height="26"
                                   ToolTip.Tip="{DynamicResource Stepper.Material.PoissonRatio.Tooltip}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Material.YieldStrengthXy}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding MaterialYieldXy}" Minimum="5" Maximum="200" Increment="5" Width="110" Height="26"
                                   ToolTip.Tip="{DynamicResource Stepper.Material.YieldStrengthXy.Tooltip}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Material.YieldStrengthZ}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding MaterialYieldZ}" Minimum="5" Maximum="200" Increment="5" Width="110" Height="26"
                                   ToolTip.Tip="{DynamicResource Stepper.Material.YieldStrengthZ.Tooltip}" />
                  </Grid>

                  <CheckBox Content="{DynamicResource Stepper.Material.ConservativeZ}"
                            IsChecked="{Binding MaterialConservativeZ}"
                            FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource Margin4T}" />

                  <TextBlock Text="{DynamicResource Stepper.Material.TdsDisclaimer}"
                             FontSize="10" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- STEP 5: RESOLUTION & PREVIEW -->
            <Border Background="{DynamicResource Bg1}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel>
                <!-- Step Header -->
                <Button Command="{Binding SelectStepCommand}" CommandParameter="5"
                        Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="{DynamicResource Pad12_8}"
                        ToolTip.Tip="{DynamicResource Stepper.Resolution.Tooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
                      <Border Width="22" Height="22" CornerRadius="{DynamicResource CornerRadius}" Background="{DynamicResource Preserve}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Common.Step5Number}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{DynamicResource Stepper.Resolution.Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Spacing4}" VerticalAlignment="Center">
                      <Border Background="{DynamicResource Warning}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad4}" IsVisible="{Binding IsResultOutdated}">
                        <TextBlock Text="{DynamicResource Stepper.Resolution.Outdated}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Bg0}" />
                      </Border>
                      <TextBlock Text="{DynamicResource Stepper.Common.CompletedCheck}" Foreground="{DynamicResource Preserve}" FontWeight="Bold" FontSize="14" IsVisible="{Binding IsStep5Completed}" />
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- Step Body -->
                <StackPanel Margin="{DynamicResource PadBody}" Spacing="{DynamicResource Spacing8}" IsVisible="{Binding ActiveStep, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=5}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Resolution.Preset}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableResolutionPresets}" SelectedItem="{Binding SelectedResolutionPreset}" Width="140" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Resolution.TargetElements}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding TargetSolidElements}" Minimum="10000" Maximum="1000000" Increment="10000" Width="110" Height="26"
                                   ToolTip.Tip="{DynamicResource Stepper.Resolution.TargetElements.Tooltip}" />
                  </Grid>

                  <!-- Estimate Metrics -->
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8}" Margin="{DynamicResource Margin4V}">
                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Resolution.VoxelSize}" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding VoxelSizeHText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Resolution.EstMemory}" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EstimatedMemoryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stepper.Resolution.EstSolveTime}" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EstimatedTimeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Action: Prepare Model -->
                  <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource Margin4T}">
                    <Button Content="{DynamicResource Stepper.Resolution.PrepareModel}"
                            Command="{Binding PrepareModelCommand}"
                            IsEnabled="{Binding !IsPreparing}"
                            Background="{DynamicResource Preserve}" Foreground="{DynamicResource Bg0}" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Stepper.Resolution.PrepareModel.Tooltip}" />
                    <Button Grid.Column="1" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelPrepareCommand}"
                            IsVisible="{Binding IsPreparing}" Background="{DynamicResource Danger}" Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource Margin4L}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Common.Cancel.Tooltip}" />
                  </Grid>

                  <ProgressBar Value="{Binding PrepareProgress}" Maximum="100" Height="4" IsVisible="{Binding IsPreparing}" />

                  <!-- Validation Issues Compact List -->
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8}" MaxHeight="100" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                          IsVisible="{Binding ValidationIssues.Count, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding ValidationIssues}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vox:ValidationIssue">
                            <Button Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).FocusIssueCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="{DynamicResource Pad4}"
                                    ToolTip.Tip="{DynamicResource Stepper.Resolution.FocusIssue.Tooltip}">
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
                                <TextBlock Text="{DynamicResource Stepper.Resolution.IssueBullet}" Foreground="{Binding SeverityColor}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>

                  <!-- Action: Run Static Analysis -->
                  <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource Margin8T}">
                    <Button Content="{DynamicResource Stepper.Analysis.Run}"
                            Command="{Binding RunStaticAnalysisCommand}"
                            IsEnabled="{Binding IsStep5Prepared}"
                            Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Stepper.Analysis.Run.Tooltip}" />
                    <Button Grid.Column="1" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelAnalysisCommand}"
                            IsVisible="{Binding IsAnalyzing}" Background="{DynamicResource Danger}" Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource Margin4L}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Common.Cancel.Tooltip}" />
                  </Grid>

                  <ProgressBar Value="{Binding AnalysisProgress}" Maximum="100" Height="4" IsVisible="{Binding IsAnalyzing}" />

                  <!-- FEA Static Results Card -->
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12}" BorderBrush="{DynamicResource Border}" BorderThickness="1" IsVisible="{Binding HasAnalysisResult}">
                    <StackPanel Spacing="{DynamicResource Spacing8}">
                      <TextBlock Text="{DynamicResource Stepper.Analysis.ResultsTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Support}" />

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Analysis.Compliance}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding ComplianceText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Analysis.MaxDisplacement}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding MaxDisplacementText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Analysis.MaxVonMises}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding MaxVonMisesText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Analysis.P99VonMises}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding P99VonMisesText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Support}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Analysis.SafetyFactorMax}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SafetyFactorText}" FontSize="11" FontWeight="Bold" Foreground="{Binding SafetyFactorBrush}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Analysis.SafetyFactorP99}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SafetyFactorP99Text}" FontSize="11" FontWeight="Bold" Foreground="{Binding SafetyFactorBrush}" />
                      </Grid>

                      <Separator Background="{DynamicResource Border}" Margin="{DynamicResource Margin4V}" />
                      <TextBlock Text="{DynamicResource Stepper.Analysis.FdmDisclaimer}"
                                 FontSize="9" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ========================================================== -->
            <!-- STEP 6: OPTIMISE                                           -->
            <!-- ========================================================== -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel>
                <!-- Step Header -->
                <Button Command="{Binding SelectStepCommand}" CommandParameter="6"
                        Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{DynamicResource Pad12}"
                        ToolTip.Tip="{DynamicResource Stepper.Optimise.Tooltip}">
                  <Grid ColumnDefinitions="24,*,Auto">
                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="{DynamicResource CornerRadius}" Background="{DynamicResource Accent}">
                      <TextBlock Text="{DynamicResource Stepper.Common.Step6Number}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Stepper.Optimise.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource Margin8L}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource Stepper.Common.CompletedCheck}" FontWeight="Bold" Foreground="{DynamicResource Preserve}" IsVisible="{Binding IsStep6Completed}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Step Body -->
                <StackPanel Margin="{DynamicResource PadBody}" Spacing="{DynamicResource Spacing8}" IsVisible="{Binding ActiveStep, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=6}">
                  <!-- Basic Parameters -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Optimise.VolumeFraction}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding OptVolumePercent, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                  </Grid>
                  <Slider Value="{Binding OptVolumePercent}" Minimum="10" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="False"
                          IsEnabled="{Binding !IsOptimising}"
                          ToolTip.Tip="{DynamicResource Stepper.Optimise.VolumeFraction.Tooltip}" />

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Optimise.MinFeatureSize}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding OptMinFeatureSizeMm}" Minimum="0.2" Maximum="25.0" Increment="0.2" FormatString="F2" Width="105" Height="26"
                                   IsEnabled="{Binding !IsOptimising}"
                                   ToolTip.Tip="{DynamicResource Stepper.Optimise.MinFeatureSize.Tooltip}" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Stepper.Optimise.MinFeatureHint}" FontSize="9" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" />

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Optimise.MaxIterations}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding OptMaxIterations}" Minimum="5" Maximum="1000" Increment="10" Width="105" Height="26"
                                   IsEnabled="{Binding !IsOptimising}"
                                   ToolTip.Tip="{DynamicResource Stepper.Optimise.MaxIterations.Tooltip}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Optimise.KeepEveryN}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding OptKeepEveryN}" Minimum="1" Maximum="50" Increment="1" Width="105" Height="26"
                                   IsEnabled="{Binding !IsOptimising}"
                                   ToolTip.Tip="{DynamicResource Stepper.Optimise.KeepEveryN.Tooltip}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Stepper.Optimise.EstDisk}" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding OptEstimatedDiskText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Support}" VerticalAlignment="Center" />
                  </Grid>

                  <!-- Collapsible Advanced Parameters -->
                  <Expander Header="{DynamicResource Stepper.Optimise.AdvancedTitle}" HorizontalAlignment="Stretch" Padding="{DynamicResource Pad4}"
                            ToolTip.Tip="{DynamicResource Stepper.Optimise.AdvancedTitle.Tooltip}">
                    <StackPanel Spacing="{DynamicResource Spacing8}" Margin="{DynamicResource Margin4T}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.Penalisation}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding OptPenal}" Minimum="1.0" Maximum="5.0" Increment="0.5" FormatString="F1" Width="95" Height="26"
                                       IsEnabled="{Binding !IsOptimising}"
                                       ToolTip.Tip="{DynamicResource Stepper.Optimise.Penalisation.Tooltip}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MoveLimit}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding OptMoveLimit}" Minimum="0.05" Maximum="0.50" Increment="0.05" FormatString="F2" Width="95" Height="26"
                                       IsEnabled="{Binding !IsOptimising}"
                                       ToolTip.Tip="{DynamicResource Stepper.Optimise.MoveLimit.Tooltip}" />
                      </Grid>
                      <CheckBox Content="{DynamicResource Stepper.Optimise.Projection}" IsChecked="{Binding OptEnableHeaviside}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                IsEnabled="{Binding !IsOptimising}"
                                ToolTip.Tip="{DynamicResource Stepper.Optimise.Projection.Tooltip}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.EminRatio}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding OptEminRatio}" Minimum="1e-12" Maximum="1e-3" FormatString="E1" Width="95" Height="26"
                                       IsEnabled="{Binding !IsOptimising}"
                                       ToolTip.Tip="{DynamicResource Stepper.Optimise.EminRatio.Tooltip}" />
                      </Grid>
                    </StackPanel>
                  </Expander>

                  <!-- Disabled Explanation Banner -->
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad8}" BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                          IsVisible="{Binding HasStartOptimisationBlockingReason}">
                    <TextBlock Text="{Binding StartOptimisationBlockingReason}" FontSize="10" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
                  </Border>

                  <!-- Start / Pause / Resume / Stop / Open Run Buttons -->
                  <Button Content="{DynamicResource Stepper.Optimise.Start}"
                          Command="{Binding StartOptimisationCommand}"
                          IsEnabled="{Binding CanStartOptimisation}"
                          IsVisible="{Binding !IsOptimising}"
                          Background="{DynamicResource Preserve}" Foreground="{DynamicResource Bg0}" FontWeight="Bold"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                          ToolTip.Tip="{DynamicResource Stepper.Optimise.Start.Tooltip}" />

                  <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsOptimising}">
                    <Button Grid.Column="0" Content="{DynamicResource Stepper.Optimise.Pause}"
                            Command="{Binding PauseOptimisationCommand}"
                            IsVisible="{Binding !IsOptimisationPaused}"
                            Background="{DynamicResource Warning}" Foreground="{DynamicResource Bg0}" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Stepper.Optimise.Pause.Tooltip}" />
                    <Button Grid.Column="0" Content="{DynamicResource Stepper.Optimise.Resume}"
                            Command="{Binding ResumeOptimisationCommand}"
                            IsVisible="{Binding IsOptimisationPaused}"
                            Background="{DynamicResource Preserve}" Foreground="{DynamicResource Bg0}" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Stepper.Optimise.Resume.Tooltip}" />
                    <Button Grid.Column="1" Content="{DynamicResource Stepper.Optimise.Stop}"
                            Command="{Binding StopOptimisationCommand}"
                            Background="{DynamicResource Danger}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                            Margin="{DynamicResource Margin4L}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                            ToolTip.Tip="{DynamicResource Stepper.Optimise.Stop.Tooltip}" />
                  </Grid>

                  <Button Content="{DynamicResource Stepper.Optimise.ContinueRun}"
                          Command="{Binding ContinueInterruptedRunCommand}"
                          IsVisible="{Binding CanContinueInterruptedRun}"
                          Background="{DynamicResource Warning}" Foreground="{DynamicResource Bg0}" FontWeight="SemiBold"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                          ToolTip.Tip="{DynamicResource Stepper.Optimise.ContinueRun.Tooltip}" />

                  <Button Content="{DynamicResource Stepper.Optimise.OpenRun}"
                          Click="OnOpenRunClick"
                          IsEnabled="{Binding !IsOptimising}"
                          Background="{DynamicResource Bg1}" Foreground="{DynamicResource TextPrimary}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                          ToolTip.Tip="{DynamicResource Stepper.Optimise.OpenRun.Tooltip}" />

                  <!-- Live Metrics & Custom Compliance Chart -->
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel Spacing="{DynamicResource Spacing8}">
                      <TextBlock Text="{DynamicResource Stepper.Optimise.LiveMetricsTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Support}" />

                      <controls:ComplianceChartControl Name="ComplianceChart"
                                                       Height="95"
                                                       ComplianceHistory="{Binding ComplianceHistory}"
                                                       SelectedIteration="{Binding SelectedIteration}"
                                                       MaxIterations="{Binding OptMaxIterations}" />

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricIteration}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveIterationText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricCompliance}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveComplianceText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Support}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricVolume}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveVolumeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricChange}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveChangeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricGrey}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveGreyText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricMsPerIter}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveMsPerIterText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricEta}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveEtaText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricSolverIters}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveSolverItersText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.MetricDiskUsed}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding OptLiveDiskUsedText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- Verify & Export Design Card -->
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                          IsVisible="{Binding HasLoadedRun}">
                    <StackPanel Spacing="{DynamicResource Spacing8}">
                      <TextBlock Text="{DynamicResource Stepper.Optimise.VerifyExportTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Preserve}" />

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.Threshold}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding VerifyThreshold}" Minimum="0.10" Maximum="0.90" Increment="0.05" FormatString="F2" Width="95" Height="26"
                                       ToolTip.Tip="{DynamicResource Stepper.Optimise.Threshold.Tooltip}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Stepper.Optimise.SmoothIters}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding ExportSmoothIterations}" Minimum="0" Maximum="10" Increment="1" Width="95" Height="26"
                                       ToolTip.Tip="{DynamicResource Stepper.Optimise.SmoothIters.Tooltip}" />
                      </Grid>

                      <Button Content="{DynamicResource Stepper.Optimise.VerifyBtn}"
                              Command="{Binding VerifyDesignCommand}"
                              IsEnabled="{Binding !IsVerifyingDesign}"
                              Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                              ToolTip.Tip="{DynamicResource Stepper.Optimise.VerifyBtn.Tooltip}" />

                      <StackPanel Spacing="{DynamicResource Spacing4}" IsVisible="{Binding HasVerificationResult}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{DynamicResource Stepper.Optimise.MaterialSaved}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Grid.Column="1" Text="{Binding VerifyMaterialSavedText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Preserve}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{DynamicResource Stepper.Optimise.ComplianceRatio}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Grid.Column="1" Text="{Binding VerifyComplianceRatioText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{DynamicResource Stepper.Analysis.MaxVonMises}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Grid.Column="1" Text="{Binding MaxVonMisesText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{DynamicResource Stepper.Analysis.P99VonMises}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Grid.Column="1" Text="{Binding P99VonMisesText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Support}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{DynamicResource Stepper.Analysis.SafetyFactorMax}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Grid.Column="1" Text="{Binding SafetyFactorText}" FontSize="11" FontWeight="Bold" Foreground="{Binding SafetyFactorBrush}" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Stepper.Analysis.FdmDisclaimer}" FontSize="9" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" TextWrapping="Wrap" />
                      </StackPanel>

                      <Button Content="{DynamicResource Stepper.Optimise.ExportStlBtn}"
                              Click="OnExportStlClick"
                              Background="{DynamicResource Preserve}" Foreground="{DynamicResource Bg0}" FontWeight="SemiBold"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                              ToolTip.Tip="{DynamicResource Stepper.Optimise.ExportStlBtn.Tooltip}" />

                      <TextBlock Text="{Binding ExportStlStatusText}" FontSize="10" Foreground="{DynamicResource Support}" TextWrapping="Wrap"
                                 IsVisible="{Binding ExportStlStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right 3D Viewport Column with Floating Overlays -->
      <Grid Grid.Column="1">
        <!-- The OpenGL Viewport -->
        <controls:Viewport3DControl Name="Viewport" />

        <!-- 1. Picking Mode Top Banner Overlay -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{DynamicResource Margin16T}"
                Background="{DynamicResource Warning}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12_8}"
                IsVisible="{Binding IsPickingActive}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing16}">
            <TextBlock Text="{Binding PickingBannerText}" FontWeight="SemiBold" Foreground="{DynamicResource Bg0}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing8}" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Picking.Angle}" FontSize="11" Foreground="{DynamicResource Bg0}" VerticalAlignment="Center" />
              <Slider Value="{Binding AngleThresholdDegrees}" Minimum="5" Maximum="60" Width="100" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Picking.Angle.Tooltip}" />
              <TextBlock Text="{Binding AngleThresholdDegrees, StringFormat='{}{0:F0}°'}" FontSize="11" Foreground="{DynamicResource Bg0}" Width="30" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="{DynamicResource Picking.Done}" Command="{Binding CancelPickingCommand}"
                    Background="{DynamicResource Bg1}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                    Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                    ToolTip.Tip="{DynamicResource Picking.Done.Tooltip}" />
          </StackPanel>
        </Border>

        <!-- 2. Outdated Banner Overlay -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{DynamicResource Margin16T}"
                Background="{DynamicResource Warning}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12_8}"
                IsVisible="{Binding IsResultOutdated}">
          <TextBlock Text="{DynamicResource Banner.OutdatedResults}"
                     FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bg0}" />
        </Border>

        <!-- 3. Floating FEA HUD & Color Legend (Top Right) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource Margin16TR}"
                Background="{DynamicResource Bg1}" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Padding="{DynamicResource Pad12}" IsVisible="{Binding HasAnalysisResult}">
          <StackPanel Spacing="{DynamicResource Spacing8}" Width="170">
            <!-- Scalar Mode Switcher -->
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing4}" HorizontalAlignment="Center">
              <RadioButton Content="{DynamicResource Hud.StressVm}" IsChecked="{Binding IsVonMisesMode}" GroupName="ScalarModeGroup" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
              <RadioButton Content="{DynamicResource Hud.Displacement}" IsChecked="{Binding !IsVonMisesMode}" GroupName="ScalarModeGroup" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Hud.Colormap}" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLuts}" SelectedItem="{Binding SelectedLutKind}" Width="95" Height="24" FontSize="10" />
            </Grid>

            <!-- Vertical Color Legend Bar -->
            <Grid ColumnDefinitions="24,*" Height="120">
              <!-- Color Gradient Rect (Simulated 256 Turbo ramp) -->
              <Border Grid.Column="0" CornerRadius="{DynamicResource CornerRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="{DynamicResource DangerColor}" />
                    <GradientStop Offset="0.25" Color="{DynamicResource WarningColor}" />
                    <GradientStop Offset="0.50" Color="{DynamicResource PreserveColor}" />
                    <GradientStop Offset="0.75" Color="{DynamicResource SupportColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource AccentColor}" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

              <!-- Min, p99, Max Text Labels -->
              <Grid Grid.Column="1" Margin="{DynamicResource Margin8L}">
                <StackPanel VerticalAlignment="Top">
                  <TextBlock Text="{Binding LegendMaxText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="{Binding LegendUnitsText}" FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <TextBlock Text="{Binding LegendP99Text}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Support}" VerticalAlignment="Center" />

                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock Text="{Binding LegendMinText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="{DynamicResource Hud.ZeroValue}" FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 4. STL Units Guard Modal Overlay -->
        <Border Background="{DynamicResource Bg0}" IsVisible="{Binding IsUnitGuardOpen}">
          <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{DynamicResource Pad24}" Width="400">
            <StackPanel Spacing="{DynamicResource Spacing12}">
              <TextBlock Text="{DynamicResource UnitGuard.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
              <TextBlock Text="{DynamicResource UnitGuard.Description}"
                         FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
              <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12_8}">
                <TextBlock Text="{Binding UnitGuardBboxText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="{DynamicResource UnitGuard.Prompt}"
                         FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

              <StackPanel Spacing="{DynamicResource Spacing8}" Margin="{DynamicResource Margin8T}">
                <Button Content="{DynamicResource UnitGuard.KeepMm}" Command="{Binding AcceptUnitAsMmCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                        ToolTip.Tip="{DynamicResource UnitGuard.KeepMm.Tooltip}" />
                <Button Content="{DynamicResource UnitGuard.RescaleMeters}" Command="{Binding RescaleFromMetersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{DynamicResource Bg2}" Foreground="{DynamicResource TextPrimary}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                        ToolTip.Tip="{DynamicResource UnitGuard.RescaleMeters.Tooltip}" />
                <Button Content="{DynamicResource UnitGuard.RescaleInches}" Command="{Binding RescaleFromInchesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{DynamicResource Bg2}" Foreground="{DynamicResource TextPrimary}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                        ToolTip.Tip="{DynamicResource UnitGuard.RescaleInches.Tooltip}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>

        <!-- 5. About Dialog Modal Overlay -->
        <Border Background="{DynamicResource Bg0}" IsVisible="{Binding IsAboutDialogOpen}">
          <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{DynamicResource Pad24}" Width="560" MaxHeight="600">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Spacing12}">
              <StackPanel Grid.Row="0" Spacing="{DynamicResource Spacing4}">
                <TextBlock Text="TopoOpt v1.0.0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Open-Source 3D Topology Optimization for Additive Manufacturing" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="License: GNU General Public License v3.0 (GPLv3)" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="Medium" />
              </StackPanel>

              <ScrollViewer Grid.Row="1" MaxHeight="400" Padding="{DynamicResource Pad4}">
                <StackPanel Spacing="{DynamicResource Spacing12}">
                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12}">
                    <StackPanel Spacing="{DynamicResource Spacing4}">
                      <TextBlock Text="INDICATIVE RESULTS DISCLAIMER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
                      <TextBlock Text="Structural stress distributions and topology-optimized geometries generated by TopoOpt are numerical engineering approximations based on linear elasticity and SIMP homogenization. FDM/FFF 3D prints exhibit significant interlayer anisotropy, porosity, and thermal variances. Physical load testing and professional FEA verification are mandatory before deploying designs in structural, safety-critical, or load-bearing applications."
                                 FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource Bg0}" CornerRadius="{DynamicResource CornerRadius}" Padding="{DynamicResource Pad12}">
                    <StackPanel Spacing="{DynamicResource Spacing4}">
                      <TextBlock Text="THIRD-PARTY OPEN-SOURCE LIBRARIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                      <TextBlock Text="• Avalonia UI (MIT License) - Copyright (c) .NET Foundation and Contributors" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="• CommunityToolkit.Mvvm (MIT License) - Copyright (c) .NET Foundation and Contributors" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="• Silk.NET.OpenGL (MIT License) - Copyright (c) Ultz Limited &amp; Contributors" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="• ScottPlot (MIT License) - Copyright (c) Scott Harden" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="• Material.Icons.Avalonia (MIT License) - Copyright (c) SvgMnt" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="• xUnit.net (Apache-2.0 License) - Copyright (c) .NET Foundation" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="Full legal text available in THIRD_PARTY_NOTICES.md in the application root." FontSize="10" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="{DynamicResource Margin4T}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <Button Grid.Row="2" Content="Close" Command="{Binding CloseAboutDialogCommand}" HorizontalAlignment="Right"
                      Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" Padding="{DynamicResource Pad12_8}" CornerRadius="{DynamicResource CornerRadius}"
                      ToolTip.Tip="Close about dialog" />
            </Grid>
          </Border>
        </Border>

        <!-- 6. Bottom Iteration Timeline & Playback Bar -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="{DynamicResource Pad12_8}" IsVisible="{Binding HasLoadedRun}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
            <Button Grid.Column="0" Content="{DynamicResource Timeline.StepBack}"
                    Command="{Binding StepBackwardTimelineCommand}"
                    Background="{DynamicResource Bg2}" Foreground="{DynamicResource TextPrimary}"
                    Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                    ToolTip.Tip="{DynamicResource Timeline.StepBack.Tooltip}" />

            <Button Grid.Column="1" Content="{DynamicResource Timeline.Play}"
                    Command="{Binding TogglePlayTimelineCommand}"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"
                    Margin="{DynamicResource Margin4L}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                    ToolTip.Tip="{DynamicResource Timeline.Play.Tooltip}" />

            <Button Grid.Column="2" Content="{DynamicResource Timeline.StepForward}"
                    Command="{Binding StepForwardTimelineCommand}"
                    Background="{DynamicResource Bg2}" Foreground="{DynamicResource TextPrimary}"
                    Margin="{DynamicResource Margin4L}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                    ToolTip.Tip="{DynamicResource Timeline.StepForward.Tooltip}" />

            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailablePlaybackSpeeds}" SelectedItem="{Binding SelectedPlaybackSpeed}"
                      Width="68" Height="28" Margin="{DynamicResource Margin8L}" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Timeline.Speed.Tooltip}" />

            <Slider Grid.Column="4" Minimum="1" Maximum="{Binding MaxAvailableIteration}" Value="{Binding SelectedIteration}"
                    Margin="{DynamicResource Pad12H}" VerticalAlignment="Center"
                    ToolTip.Tip="{DynamicResource Timeline.Slider.Tooltip}" />

            <TextBlock Grid.Column="5" Text="{Binding TimelineIterationLabel}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Width="115" VerticalAlignment="Center" />

            <CheckBox Grid.Column="6" Content="{DynamicResource Timeline.Live}" IsChecked="{Binding IsLiveFollow}"
                      FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource Margin8L}" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Timeline.Live.Tooltip}" />

            <CheckBox Grid.Column="7" Content="{DynamicResource Timeline.Ghost}" IsChecked="{Binding ShowGhostOriginal}"
                      FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource Margin8L}" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Timeline.Ghost.Tooltip}" />

            <Button Grid.Column="8" Content="{DynamicResource Stepper.Optimise.OpenRun}"
                    Click="OnOpenRunClick"
                    IsEnabled="{Binding !IsOptimising}"
                    Background="{DynamicResource Bg2}" Foreground="{DynamicResource TextPrimary}"
                    Margin="{DynamicResource Margin8L}" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                    ToolTip.Tip="{DynamicResource Stepper.Optimise.OpenRun.Tooltip}" />
          </Grid>
        </Border>

        <!-- 6. Window Close Confirmation Modal Overlay during active run -->
        <Border Name="CloseConfirmOverlay" Background="{DynamicResource Bg0}" IsVisible="False">
          <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{DynamicResource Pad24}" Width="400">
            <StackPanel Spacing="{DynamicResource Spacing12}">
              <TextBlock Text="{DynamicResource CloseConfirm.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
              <TextBlock Text="{DynamicResource CloseConfirm.Description}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
              <StackPanel Spacing="{DynamicResource Spacing8}" Margin="{DynamicResource Margin8T}">
                <Button Content="{DynamicResource CloseConfirm.StopAndExit}" Click="OnConfirmStopAndExitClick"
                        Background="{DynamicResource Danger}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                        ToolTip.Tip="{DynamicResource CloseConfirm.StopAndExit.Tooltip}" />
                <Button Content="{DynamicResource CloseConfirm.KeepRunning}" Click="OnCancelCloseClick"
                        Background="{DynamicResource Bg2}" Foreground="{DynamicResource TextPrimary}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="{DynamicResource Pad8_4}" CornerRadius="{DynamicResource CornerRadius}"
                        ToolTip.Tip="{DynamicResource CloseConfirm.KeepRunning.Tooltip}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>

    <!-- 3. Bottom Status Bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource Bg0}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0"
            Padding="{DynamicResource Pad12H}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{DynamicResource StatusBar.Ready}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{Binding FpsText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>
</Window>
