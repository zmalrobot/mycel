<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette Colors -->
  <Color x:Key="Bg0Color">#0D0F14</Color>
  <Color x:Key="Bg1Color">#141720</Color>
  <Color x:Key="Bg2Color">#1E2330</Color>
  <Color x:Key="BorderColor">#262D3D</Color>
  <Color x:Key="TextPrimaryColor">#E2E8F0</Color>
  <Color x:Key="TextSecondaryColor">#94A3B8</Color>
  <Color x:Key="AccentColor">#2563EB</Color>
  <Color x:Key="LoadColor">#FF9F40</Color>
  <Color x:Key="SupportColor">#4DA3FF</Color>
  <Color x:Key="PreserveColor">#5BD18B</Color>
  <Color x:Key="DangerColor">#EF4444</Color>
  <Color x:Key="WarningColor">#F59E0B</Color>

  <!-- Shared Brushes (Stable Keys) -->
  <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
  <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
  <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Load" Color="{StaticResource LoadColor}" />
  <SolidColorBrush x:Key="Support" Color="{StaticResource SupportColor}" />
  <SolidColorBrush x:Key="Preserve" Color="{StaticResource PreserveColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />

  <!-- Spacing Tokens (4 / 8 / 12 / 16 / 24) -->
  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
  <x:Double x:Key="Spacing24">24</x:Double>

  <!-- Padding & Margin Thickness Tokens (4 / 8 / 12 / 16 / 24) -->
  <Thickness x:Key="Pad4">4</Thickness>
  <Thickness x:Key="Pad8">8</Thickness>
  <Thickness x:Key="Pad12">12</Thickness>
  <Thickness x:Key="Pad16">16</Thickness>
  <Thickness x:Key="Pad24">24</Thickness>
  <Thickness x:Key="Pad12H">12,0</Thickness>
  <Thickness x:Key="Pad8_4">8,4</Thickness>
  <Thickness x:Key="Pad12_8">12,8</Thickness>
  <Thickness x:Key="PadBody">12,0,12,12</Thickness>
  <Thickness x:Key="Margin4V">0,4</Thickness>
  <Thickness x:Key="Margin4T">0,4,0,0</Thickness>
  <Thickness x:Key="Margin8T">0,8,0,0</Thickness>
  <Thickness x:Key="Margin16T">0,16,0,0</Thickness>
  <Thickness x:Key="Margin16TR">0,16,16,0</Thickness>
  <Thickness x:Key="Margin4L">4,0,0,0</Thickness>
  <Thickness x:Key="Margin8L">8,0,0,0</Thickness>
  <Thickness x:Key="Margin4H">4,0</Thickness>

  <!-- Corner Radius Token (8) -->
  <CornerRadius x:Key="CornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CornerRadius8">8</CornerRadius>

  <!-- User-Visible Strings (Mirroring Resources/Strings.resx) -->
  <x:String x:Key="App.Title">TopoOpt — Topology Optimization</x:String>
  <x:String x:Key="Toolbar.OpenStl">Open STL</x:String>
  <x:String x:Key="Toolbar.OpenStl.Tooltip">Open an STL mesh file (Ctrl+O)</x:String>
  <x:String x:Key="Toolbar.OpenProject">Open Project</x:String>
  <x:String x:Key="Toolbar.OpenProject.Tooltip">Open an existing project folder</x:String>
  <x:String x:Key="Toolbar.SaveProject">Save Project</x:String>
  <x:String x:Key="Toolbar.SaveProject.Tooltip">Save current project into a folder</x:String>
  <x:String x:Key="Toolbar.FitView">Fit View</x:String>
  <x:String x:Key="Toolbar.FitView.Tooltip">Fit camera to model geometry (F)</x:String>

  <x:String x:Key="Stepper.Common.Step1Number">1</x:String>
  <x:String x:Key="Stepper.Common.Step2Number">2</x:String>
  <x:String x:Key="Stepper.Common.Step3Number">3</x:String>
  <x:String x:Key="Stepper.Common.Step4Number">4</x:String>
  <x:String x:Key="Stepper.Common.Step5Number">5</x:String>
  <x:String x:Key="Stepper.Common.CompletedCheck">✓</x:String>
  <x:String x:Key="Stepper.Common.RemoveSymbol">✕</x:String>
  <x:String x:Key="Stepper.Common.PickOnMesh">Pick on Mesh</x:String>
  <x:String x:Key="Stepper.Common.PickOnMesh.Tooltip">Select surface triangles on the 3D mesh</x:String>
  <x:String x:Key="Common.Cancel">Cancel</x:String>
  <x:String x:Key="Common.Cancel.Tooltip">Cancel the current operation</x:String>

  <x:String x:Key="Stepper.Model.Title">Model &amp; Geometry</x:String>
  <x:String x:Key="Stepper.Model.Tooltip">Expand model and geometry summary</x:String>
  <x:String x:Key="Stepper.Model.ImportUnit">Import Unit:</x:String>
  <x:String x:Key="Stepper.Model.Triangles">Triangles:</x:String>
  <x:String x:Key="Stepper.Model.Vertices">Vertices:</x:String>
  <x:String x:Key="Stepper.Model.BoundingBox">Bounding Box:</x:String>
  <x:String x:Key="Stepper.Model.Volume">Volume:</x:String>

  <x:String x:Key="Stepper.Loads.Title">Applied Loads</x:String>
  <x:String x:Key="Stepper.Loads.Tooltip">Expand applied load regions</x:String>
  <x:String x:Key="Stepper.Loads.Add">+ Add Load Region</x:String>
  <x:String x:Key="Stepper.Loads.Add.Tooltip">Add a new applied force region</x:String>
  <x:String x:Key="Stepper.Loads.Remove.Tooltip">Remove this load region</x:String>
  <x:String x:Key="Stepper.Loads.Magnitude">Magnitude (N):</x:String>
  <x:String x:Key="Stepper.Loads.Magnitude.Tooltip">Total applied force in Newtons</x:String>
  <x:String x:Key="Stepper.Loads.Direction">Direction:</x:String>
  <x:String x:Key="Stepper.Loads.CustomX.Tooltip">Custom force direction X component</x:String>
  <x:String x:Key="Stepper.Loads.CustomY.Tooltip">Custom force direction Y component</x:String>
  <x:String x:Key="Stepper.Loads.CustomZ.Tooltip">Custom force direction Z component</x:String>

  <x:String x:Key="Stepper.Supports.Title">Fixed Supports</x:String>
  <x:String x:Key="Stepper.Supports.Tooltip">Expand fixed support constraints</x:String>
  <x:String x:Key="Stepper.Supports.Add">+ Add Fixed Support</x:String>
  <x:String x:Key="Stepper.Supports.Add.Tooltip">Add a new fixed support constraint</x:String>
  <x:String x:Key="Stepper.Supports.Remove.Tooltip">Remove this support constraint</x:String>
  <x:String x:Key="Stepper.Supports.FixX">Fix X</x:String>
  <x:String x:Key="Stepper.Supports.FixY">Fix Y</x:String>
  <x:String x:Key="Stepper.Supports.FixZ">Fix Z</x:String>

  <x:String x:Key="Stepper.Material.Title">Material</x:String>
  <x:String x:Key="Stepper.Material.Tooltip">Expand material properties and presets</x:String>
  <x:String x:Key="Stepper.Material.Preset">Preset:</x:String>
  <x:String x:Key="Stepper.Material.YoungModulus">Young's Modulus E (MPa):</x:String>
  <x:String x:Key="Stepper.Material.YoungModulus.Tooltip">Elastic Young's modulus E in MPa</x:String>
  <x:String x:Key="Stepper.Material.PoissonRatio">Poisson's Ratio ν:</x:String>
  <x:String x:Key="Stepper.Material.PoissonRatio.Tooltip">Poisson's ratio (dimensionless, 0.05 to 0.49)</x:String>
  <x:String x:Key="Stepper.Material.YieldStrengthXy">Yield Strength XY (MPa):</x:String>
  <x:String x:Key="Stepper.Material.YieldStrengthXy.Tooltip">In-plane XY tensile yield strength in MPa</x:String>
  <x:String x:Key="Stepper.Material.YieldStrengthZ">Yield Strength Z (MPa):</x:String>
  <x:String x:Key="Stepper.Material.YieldStrengthZ.Tooltip">Inter-layer Z tensile yield strength in MPa</x:String>
  <x:String x:Key="Stepper.Material.ConservativeZ">Conservative (use Z strength)</x:String>
  <x:String x:Key="Stepper.Material.TdsDisclaimer">* Indicative manufacturer values from Polymaker / eSUN TDS</x:String>

  <x:String x:Key="Stepper.Resolution.Title">Resolution &amp; Analysis</x:String>
  <x:String x:Key="Stepper.Resolution.Tooltip">Expand voxel resolution and static analysis</x:String>
  <x:String x:Key="Stepper.Resolution.Outdated">Outdated</x:String>
  <x:String x:Key="Stepper.Resolution.Preset">Preset:</x:String>
  <x:String x:Key="Stepper.Resolution.TargetElements">Target Elements:</x:String>
  <x:String x:Key="Stepper.Resolution.TargetElements.Tooltip">Target count of active solid voxel elements</x:String>
  <x:String x:Key="Stepper.Resolution.VoxelSize">Voxel size</x:String>
  <x:String x:Key="Stepper.Resolution.EstMemory">Est. Memory</x:String>
  <x:String x:Key="Stepper.Resolution.EstSolveTime">Est. Solve Time</x:String>
  <x:String x:Key="Stepper.Resolution.PrepareModel">Prepare Model</x:String>
  <x:String x:Key="Stepper.Resolution.PrepareModel.Tooltip">Voxelize mesh and map boundary conditions</x:String>
  <x:String x:Key="Stepper.Resolution.IssueBullet">●</x:String>
  <x:String x:Key="Stepper.Resolution.FocusIssue.Tooltip">Focus camera on this validation issue</x:String>

  <x:String x:Key="Stepper.Analysis.Run">Run Static Analysis</x:String>
  <x:String x:Key="Stepper.Analysis.Run.Tooltip">Solve linear elastic finite element model</x:String>
  <x:String x:Key="Stepper.Analysis.ResultsTitle">Static Analysis Results</x:String>
  <x:String x:Key="Stepper.Analysis.Compliance">Compliance (Work):</x:String>
  <x:String x:Key="Stepper.Analysis.MaxDisplacement">Max Displacement:</x:String>
  <x:String x:Key="Stepper.Analysis.MaxVonMises">Max von Mises:</x:String>
  <x:String x:Key="Stepper.Analysis.P99VonMises">p99 von Mises (filtered):</x:String>
  <x:String x:Key="Stepper.Analysis.SafetyFactorMax">Safety Factor SF (max):</x:String>
  <x:String x:Key="Stepper.Analysis.SafetyFactorP99">Safety Factor SF (p99):</x:String>
  <x:String x:Key="Stepper.Analysis.FdmDisclaimer">Indicative results. FDM parts are anisotropic and material data vary: verify load-bearing parts with physical tests.</x:String>

  <x:String x:Key="Picking.Angle">Angle:</x:String>
  <x:String x:Key="Picking.Angle.Tooltip">Dihedral angle threshold in degrees for region growing</x:String>
  <x:String x:Key="Picking.Done">Done (Esc)</x:String>
  <x:String x:Key="Picking.Done.Tooltip">Finish surface selection mode (Esc)</x:String>

  <x:String x:Key="Banner.OutdatedResults">⚠ Parameters changed: Static analysis results are outdated. Re-run analysis to update.</x:String>

  <x:String x:Key="Hud.StressVm">Stress (vM)</x:String>
  <x:String x:Key="Hud.Displacement">Disp</x:String>
  <x:String x:Key="Hud.Colormap">Colormap:</x:String>
  <x:String x:Key="Hud.ZeroValue">0.0</x:String>

  <x:String x:Key="UnitGuard.Title">⚠ STL Unit Guard</x:String>
  <x:String x:Key="UnitGuard.Description">The imported model bounding box appears to have unusual dimensions:</x:String>
  <x:String x:Key="UnitGuard.Prompt">Please confirm the intended unit of measure to rescale to millimeters:</x:String>
  <x:String x:Key="UnitGuard.KeepMm">Keep as Millimeters (mm)</x:String>
  <x:String x:Key="UnitGuard.KeepMm.Tooltip">Keep coordinates in millimeters without scaling</x:String>
  <x:String x:Key="UnitGuard.RescaleMeters">Rescale from Meters (×1000)</x:String>
  <x:String x:Key="UnitGuard.RescaleMeters.Tooltip">Multiply mesh coordinates by 1000 (m to mm)</x:String>
  <x:String x:Key="UnitGuard.RescaleInches">Rescale from Inches (×25.4)</x:String>
  <x:String x:Key="UnitGuard.RescaleInches.Tooltip">Multiply mesh coordinates by 25.4 (in to mm)</x:String>

  <x:String x:Key="StatusBar.Ready">TopoOpt v1.0 — Ready</x:String>

</ResourceDictionary>
